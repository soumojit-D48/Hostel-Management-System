# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL_POOLED=postgresql://username:password@host:port/database?sslmode=require&pgbouncer=true

# Redis Configuration (Upstash)
REDIS_URL=redis://username:password@host:port

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=30d

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Monitoring (Sentry)
SENTRY_DSN=your_sentry_dsn

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=52428800
MAX_IMAGES_PER_ISSUE=5
MAX_VIDEOS_PER_ISSUE=1

# Background Jobs
BULLMQ_REDIS_URL=redis://username:password@host:port

# WebSocket
SOCKET_CORS_ORIGIN=http://localhost:3000